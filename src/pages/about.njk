<!-- モーダル -->
<div class="gallery-ws__modal" id="galleryModal">
  <span class="gallery-ws__close" id="galleryClose">&times;</span>
  <img class="gallery-ws__modal-img" id="galleryModalImg" alt="">
</div>

<script>
  // モーダル要素
  const modal = document.getElementById('galleryModal');
  const modalImg = document.getElementById('galleryModalImg');
  const closeBtn = document.getElementById('galleryClose');

  // 画像クリックでモーダル表示
  document.querySelectorAll('.gallery-ws__img').forEach(img => {
    img.addEventListener('click', () => {
      modal.style.display = 'flex'; // flexで中央寄せ
      modalImg.src = img.src;
      document.body.style.overflow = 'hidden'; // 背景スクロール禁止
    });
  });

  // ❌ボタンクリックでモーダル閉じる
  closeBtn.addEventListener('click', () => {
    modal.style.display = 'none';
    modalImg.src = '';
    document.body.style.overflow = ''; // スクロール戻す
  });

  // モーダル背景クリックで閉じる
  modal.addEventListener('click', (e) => {
    if (e.target === modal) {
      modal.style.display = 'none';
      modalImg.src = '';
      document.body.style.overflow = '';
    }
  });
</script>


