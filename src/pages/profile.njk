<script>
document.querySelectorAll('.about-ws__note-article').forEach(link => {
  const card = link.querySelector('.about-ws__note-card');
  const title = link.dataset.title;
  const excerpt = link.dataset.excerpt;

  card.innerHTML = `
    <h4 class="about-ws__note-title">${title}</h4>
    <p class="about-ws__note-excerpt">${excerpt}</p>
  `;
});
</script>