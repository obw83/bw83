---
layout: base.njk
title: お知らせ
permalink: /news/index.html
---

<section class="news">
  <h2 class="news__heading">お知らせ</h2>
  <ul class="news__list">
    {% for post in collections.posts %}
      <li class="news__item">
        <a href="{{ post.url }}" class="news__link">{{ post.data.title }}</a>
        <span class="news__date">（{{ post.date | jpDate }}）</span>
      </li>
    {% endfor %}
  </ul>
</section>